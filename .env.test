# Service
SERVICE_NAME=caching_svc
LOG_LEVEL=WARNING

# Database (see docker-compose `postgres-test` service)
DATABASE__URL=postgresql+asyncpg://caching_test:caching_test_password@localhost:5442/caching_test
DATABASE__USE_NULL_POOL=True

# Keep the test suite fast; latency is irrelevant for call-count assertions
TRANSFORMER__DELAY_SECONDS=0
